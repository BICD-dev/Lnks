generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Url {
  id         String   @id @default(cuid()) 
  originalUrl String
  shortCode   String   @unique
  clickCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}